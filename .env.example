# Supabase (browser — anon/publishable key only). Never put service_role or DB password here.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Also run SQL: supabase/migrations/20260808170000_shared_ledger.sql
#             + supabase/migrations/20260808183000_user_profiles_settings.sql
# Enable Email auth in Supabase Dashboard (Auth → Providers).

# Optional: override Kilo proxy base (default: ${VITE_SUPABASE_URL}/functions/v1/kilo-proxy)
# VITE_KILO_GATEWAY_BASE=https://YOUR_PROJECT.supabase.co/functions/v1/kilo-proxy

# EmailJS OTP (public keys — safe in SPA build)
VITE_EMAILJS_SERVICE_ID=service_xxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional Gemini key for local dev (user can also paste in Settings)
# VITE_GEMINI_API_KEY=
