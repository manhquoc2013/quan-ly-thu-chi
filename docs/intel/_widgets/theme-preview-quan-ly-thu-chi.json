{
  "content": "import { useState } from \"react\";\nimport {\n  Palette, Component, LayoutGrid, BarChart3,\n  Search, Plus, Trash2, Check, Clock, X, ChevronDown,\n  ArrowUpCircle, ArrowDownCircle, FileText, Bot, Settings,\n  Database, Zap, Link, AlertTriangle, Calendar, DollarSign,\n  CreditCard, Tag, Camera, MoreHorizontal, Filter\n} from \"lucide-react\";\n\n// ===== THEME TOKENS =====\nconst tokens = {\n  colors: {\n    background: '#EFF2F7',\n    surface: '#FAFBFC',\n    surfaceHover: '#F1F5F9',\n    border: '#CBD5E1',\n    borderSubtle: '#E0E3E8',\n    textPrimary: '#333333',\n    textSecondary: '#475569',\n    textMuted: '#64748B',\n    accentBg: '#E3F2FD',\n    accentFg: '#1565C0',\n    secondaryFg: '#0F766E',\n    neutralBg: '#ECEFF1',\n    neutralFg: '#37474F',\n    dangerBg: '#FFEBEE',\n    dangerFg: '#C62828',\n    successBg: '#ECFDF5',\n    successFg: '#065F46',\n    warningBg: '#FEF3C7',\n    warningFg: '#92400E',\n    infoBg: '#E0F2FE',\n    infoFg: '#1E3A8A',\n    runBg: '#1565C0',\n    runFg: '#FFFFFF',\n    sidebarBg: '#1E293B',\n    gridHeaderBg: '#F1F5F9',\n    gridHeaderFg: '#334155',\n  },\n  category: {\n    office: '#3B82F6',\n    rent: '#8B5CF6',\n    utilities: '#F59E0B',\n    salary: '#10B981',\n    marketing: '#EC4899',\n    supplies: '#6366F1',\n    transportation: '#14B8A6',\n    maintenance: '#F97316',\n    tax: '#EF4444',\n    other: '#6B7280',\n  },\n  spacing: { xs: 4, sm: 6, md: 8, lg: 12, xl: 16 },\n  radius: { field: 4, panel: 6, dialog: 8, badge: 12 },\n  fontSize: { xs: 11, sm: 12, base: 13, lg: 14, xl: 16 },\n};\n\n// ===== COMPONENTS =====\nfunction Badge({ children, variant = 'neutral', dot }: { children: string; variant?: 'success'|'warning'|'error'|'neutral'|'accent'; dot?: boolean }) {\n  const cfg = {\n    success: { bg: tokens.colors.successBg, fg: tokens.colors.successFg },\n    warning: { bg: tokens.colors.warningBg, fg: tokens.colors.warningFg },\n    error: { bg: tokens.colors.dangerBg, fg: tokens.colors.dangerFg },\n    neutral: { bg: tokens.colors.neutralBg, fg: tokens.colors.neutralFg },\n    accent: { bg: tokens.colors.accentBg, fg: tokens.colors.accentFg },\n  }[variant];\n  return <span style={{ display:'inline-flex', alignItems:'center', gap:4, padding:'1px 6px', fontSize:tokens.fontSize.xs, fontWeight:500, borderRadius:tokens.radius.badge, background:cfg.bg, color:cfg.fg }}>\n    {dot && <span style={{ width:6, height:6, borderRadius:'50%', background:cfg.fg }} />}\n    {children}\n  </span>;\n}\n\nfunction Button({ children, variant = 'neutral', icon: Icon, busy }: { children: string; variant?: 'run'|'danger'|'neutral'|'accent'; icon?: any; busy?: boolean }) {\n  const cfg = {\n    run: { bg: tokens.colors.runBg, fg: tokens.colors.runFg, hoverBg: '#0D47A1' },\n    danger: { bg: tokens.colors.dangerFg, fg: '#FFFFFF', hoverBg: '#B71C1C' },\n    neutral: { bg: tokens.colors.neutralBg, fg: tokens.colors.neutralFg, hoverBg: '#CFD8DC' },\n    accent: { bg: tokens.colors.accentBg, fg: tokens.colors.accentFg, hoverBg: '#BBDEFB' },\n  }[variant];\n  return <button style={{\n    display:'inline-flex', alignItems:'center', gap:4, padding:'2px 8px',\n    fontSize:tokens.fontSize.xs, fontWeight:500, borderRadius:tokens.radius.field,\n    background:cfg.bg, color:cfg.fg, border:'none', cursor:'pointer',\n    transition:'all 150ms',\n  }} onMouseEnter={e => (e.currentTarget.style.background = cfg.hoverBg)}\n     onMouseLeave={e => (e.currentTarget.style.background = cfg.bg)}>\n    {busy ? <span style={{ width:12, height:12, border:'2px solid', borderTopColor:'transparent', borderRadius:'50%', display:'inline-block', animation:'spin 0.6s linear infinite' }} /> : Icon && <Icon size={15} />}\n    {children}\n  </button>;\n}\n\nfunction Panel({ title, icon: Icon, style: panelStyle = 'solid', titleTrailing, children }: any) {\n  const isTrans = panelStyle === 'translucent';\n  return <div style={{\n    background: isTrans ? 'rgba(250,251,252,0.85)' : tokens.colors.surface,\n    backdropFilter: isTrans ? 'blur(8px)' : 'none',\n    border: `1px solid ${isTrans ? tokens.colors.borderSubtle : tokens.colors.border}`,\n    borderRadius: tokens.radius.panel, padding: tokens.spacing.md, height:'100%', boxSizing:'border-box',\n  }}>\n    {(title || titleTrailing) && <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom: tokens.spacing.sm }}>\n      <div style={{ display:'flex', alignItems:'center', gap: tokens.spacing.xs }}>\n        {Icon && <Icon size={14} color={tokens.colors.accentFg} />}\n        {title && <span style={{ fontSize: tokens.fontSize.sm, fontWeight: 600, color: tokens.colors.textSecondary }}>{title}</span>}\n      </div>\n      {titleTrailing}\n    </div>}\n    {children}\n  </div>;\n}\n\n// ===== MOCK DATA =====\nconst expenses = [\n  { date:'15/07/2026', cat:'Văn phòng phẩm', catKey:'office', desc:'Giấy in A4 Double A 5 ram', amount:250000, status:'paid', inv:true },\n  { date:'14/07/2026', cat:'Điện nước', catKey:'utilities', desc:'Tiền điện tháng 7', amount:1200000, status:'pending', inv:false },\n  { date:'13/07/2026', cat:'Vận chuyển', catKey:'transportation', desc:'Xăng xe đi giao hàng', amount:350000, status:'paid', inv:false },\n  { date:'12/07/2026', cat:'Marketing', catKey:'marketing', desc:'Chạy quảng cáo Facebook', amount:2000000, status:'paid', inv:true },\n  { date:'10/07/2026', cat:'Bảo trì', catKey:'maintenance', desc:'Sửa máy lạnh văn phòng', amount:800000, status:'cancelled', inv:false },\n];\n\nfunction formatVND(n: number) { return n.toLocaleString('vi-VN') + ' ₫'; }\n\n// ===== TABS =====\nconst tabs = ['🎨 Màu sắc', '🧩 Components', '📊 Grid Chi Phí', '📋 Tokens'] as const;\ntype Tab = typeof tabs[number];\n\nfunction ColorSwatch({ name, hex, text }: { name: string; hex: string; text?: string }) {\n  return <div style={{ display:'flex', alignItems:'center', gap:8, padding:'4px 0' }}>\n    <div style={{ width:32, height:32, borderRadius:tokens.radius.field, background:hex, border:'1px solid #E0E3E8', flexShrink:0 }} />\n    <div>\n      <div style={{ fontSize:tokens.fontSize.sm, fontWeight:500, color:tokens.colors.textPrimary }}>{name}</div>\n      <div style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted, fontFamily:'monospace' }}>{hex}</div>\n    </div>\n  </div>;\n}\n\nexport default function App() {\n  const [tab, setTab] = useState<Tab>(tabs[0]);\n\n  return (\n    <div style={{ fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif\", background: tokens.colors.background, minHeight:'100vh', padding:0 }}>\n      {/* Header */}\n      <div style={{ background: tokens.colors.sidebarBg, color:'#CBD5E1', padding:'8px 16px', display:'flex', alignItems:'center', justifyContent:'space-between' }}>\n        <div style={{ display:'flex', alignItems:'center', gap:12 }}>\n          <span style={{ fontSize:tokens.fontSize.lg, fontWeight:700, color:'#FFFFFF' }}>🏠 Quản Lý Thu Chi</span>\n          <span style={{ fontSize:tokens.fontSize.xs, padding:'2px 8px', borderRadius:tokens.radius.badge, background:'#334155', color:'#94A3B8' }}>Theme Preview v1.0</span>\n        </div>\n        <div style={{ display:'flex', alignItems:'center', gap:12, fontSize:tokens.fontSize.xs }}>\n          <Badge variant=\"success\" dot>Đã đồng bộ</Badge>\n          <span style={{ color:'#64748B' }}>14:35 · 01/08/2026</span>\n        </div>\n      </div>\n\n      {/* Tab bar */}\n      <div style={{ background:tokens.colors.surface, borderBottom:`1px solid ${tokens.colors.border}`, padding:'0 16px', display:'flex', gap:1 }}>\n        {tabs.map(t => (\n          <button key={t} onClick={() => setTab(t)} style={{\n            padding:'8px 16px', fontSize:tokens.fontSize.sm, fontWeight:tab===t?600:400,\n            color:tab===t?tokens.colors.accentFg:tokens.colors.textSecondary,\n            border:'none', borderBottom:tab===t?`2px solid ${tokens.colors.accentFg}`:'2px solid transparent',\n            background:'none', cursor:'pointer', transition:'all 150ms',\n          }}>{t}</button>\n        ))}\n      </div>\n\n      <div style={{ padding: tokens.spacing.md, maxWidth:960, margin:'0 auto' }}>\n        {/* ========== TAB 0: COLOR PALETTE ========== */}\n        {tab === tabs[0] && (\n          <div style={{ display:'flex', flexDirection:'column', gap:tokens.spacing.md }}>\n            <Panel title=\"Surface & Text\" icon={Palette}>\n              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8 }}>\n                <ColorSwatch name=\"Background\" hex={tokens.colors.background} />\n                <ColorSwatch name=\"Surface\" hex={tokens.colors.surface} />\n                <ColorSwatch name=\"Border\" hex={tokens.colors.border} />\n                <ColorSwatch name=\"Text Primary\" hex={tokens.colors.textPrimary} />\n                <ColorSwatch name=\"Text Secondary\" hex={tokens.colors.textSecondary} />\n                <ColorSwatch name=\"Text Muted\" hex={tokens.colors.textMuted} />\n              </div>\n            </Panel>\n\n            <Panel title=\"Semantic Colors\" icon={AlertTriangle}>\n              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8 }}>\n                <ColorSwatch name=\"Success BG\" hex={tokens.colors.successBg} />\n                <ColorSwatch name=\"Success FG\" hex={tokens.colors.successFg} />\n                <ColorSwatch name=\"Warning BG\" hex={tokens.colors.warningBg} />\n                <ColorSwatch name=\"Warning FG\" hex={tokens.colors.warningFg} />\n                <ColorSwatch name=\"Danger BG\" hex={tokens.colors.dangerBg} />\n                <ColorSwatch name=\"Danger FG\" hex={tokens.colors.dangerFg} />\n                <ColorSwatch name=\"Info BG\" hex={tokens.colors.infoBg} />\n                <ColorSwatch name=\"Info FG\" hex={tokens.colors.infoFg} />\n              </div>\n            </Panel>\n\n            <Panel title=\"Danh mục chi phí\" icon={Tag}>\n              <div style={{ display:'grid', gridTemplateColumns:'repeat(5, 1fr)', gap:8 }}>\n                {Object.entries(tokens.category).map(([key, color]) => (\n                  <div key={key} style={{ display:'flex', alignItems:'center', gap:6, fontSize:tokens.fontSize.xs }}>\n                    <div style={{ width:12, height:12, borderRadius:3, background:color }} />\n                    <span style={{ color:tokens.colors.textSecondary }}>{key}</span>\n                  </div>\n                ))}\n              </div>\n            </Panel>\n          </div>\n        )}\n\n        {/* ========== TAB 1: COMPONENTS ========== */}\n        {tab === tabs[1] && (\n          <div style={{ display:'flex', flexDirection:'column', gap:tokens.spacing.md }}>\n            <Panel title=\"Button Variants\" icon={Component}>\n              <div style={{ display:'flex', gap:8, flexWrap:'wrap' }}>\n                <Button variant=\"run\" icon={Plus}>Thêm chi phí</Button>\n                <Button variant=\"neutral\" icon={Filter}>Lọc</Button>\n                <Button variant=\"accent\" icon={FileText}>Xuất báo cáo</Button>\n                <Button variant=\"danger\" icon={Trash2}>Xóa</Button>\n                <Button variant=\"neutral\" icon={Zap} busy>Đang xử lý</Button>\n              </div>\n            </Panel>\n\n            <Panel title=\"Badge Variants\" icon={Check}>\n              <div style={{ display:'flex', gap:8, flexWrap:'wrap' }}>\n                <Badge variant=\"success\" dot>Đã thanh toán</Badge>\n                <Badge variant=\"warning\" dot>Chờ thanh toán</Badge>\n                <Badge variant=\"error\" dot>Đã hủy</Badge>\n                <Badge variant=\"accent\">Đang xử lý</Badge>\n                <Badge variant=\"neutral\">Mới tạo</Badge>\n                <Badge variant=\"success\">Hoàn thành</Badge>\n              </div>\n            </Panel>\n\n            <Panel title=\"Panel Styles\" icon={LayoutGrid}>\n              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8 }}>\n                <Panel title=\"Solid Panel\" icon={Database}>\n                  <div style={{ fontSize:tokens.fontSize.sm, color:tokens.colors.textSecondary }}>\n                    Nền solid, border rõ, dùng cho form & content chính\n                  </div>\n                </Panel>\n                <Panel title=\"Translucent Panel\" icon={Link} style=\"translucent\">\n                  <div style={{ fontSize:tokens.fontSize.sm, color:tokens.colors.textSecondary }}>\n                    Nền trong suốt, border nhạt, dùng cho grid & overlay\n                  </div>\n                </Panel>\n              </div>\n            </Panel>\n\n            <Panel title=\"Form Elements\">\n              <div style={{ display:'flex', flexDirection:'column', gap:8 }}>\n                <div>\n                  <label style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textSecondary, display:'block', marginBottom:2 }}>Mô tả</label>\n                  <input placeholder=\"Nhập mô tả...\" style={{\n                    width:'100%', padding:'4px 8px', fontSize:tokens.fontSize.sm,\n                    border:`1px solid ${tokens.colors.border}`, borderRadius:tokens.radius.field,\n                    background:tokens.colors.surface, color:tokens.colors.textPrimary, outline:'none', boxSizing:'border-box',\n                  }} />\n                </div>\n                <div style={{ display:'flex', gap:8 }}>\n                  <div style={{ flex:1 }}>\n                    <label style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textSecondary, display:'block', marginBottom:2 }}>Danh mục</label>\n                    <select style={{\n                      width:'100%', padding:'4px 8px', fontSize:tokens.fontSize.sm,\n                      border:`1px solid ${tokens.colors.border}`, borderRadius:tokens.radius.field,\n                      background:tokens.colors.surface, color:tokens.colors.textPrimary, outline:'none', boxSizing:'border-box',\n                    }}>\n                      <option>Văn phòng phẩm</option>\n                      <option>Điện nước</option>\n                      <option>Vận chuyển</option>\n                    </select>\n                  </div>\n                  <div style={{ flex:1 }}>\n                    <label style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textSecondary, display:'block', marginBottom:2 }}>Số tiền</label>\n                    <div style={{ position:'relative' }}>\n                      <input placeholder=\"0\" style={{\n                        width:'100%', padding:'4px 8px', fontSize:tokens.fontSize.sm,\n                        border:`1px solid ${tokens.colors.border}`, borderRadius:tokens.radius.field,\n                        background:tokens.colors.surface, color:tokens.colors.textPrimary, outline:'none', boxSizing:'border-box',\n                      }} />\n                      <span style={{ position:'absolute', right:8, top:'50%', transform:'translateY(-50%)', fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>₫</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </Panel>\n          </div>\n        )}\n\n        {/* ========== TAB 2: EXPENSE GRID ========== */}\n        {tab === tabs[2] && (\n          <div style={{ display:'flex', flexDirection:'column', gap:tokens.spacing.md }}>\n            {/* Toolbar */}\n            <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between' }}>\n              <div style={{ display:'flex', gap:8, alignItems:'center' }}>\n                <div style={{ position:'relative' }}>\n                  <Search size={14} style={{ position:'absolute', left:8, top:'50%', transform:'translateY(-50%)', color:tokens.colors.textMuted }} />\n                  <input placeholder=\"Tìm kiếm...\" style={{\n                    padding:'4px 8px 4px 26px', fontSize:tokens.fontSize.sm, width:180,\n                    border:`1px solid ${tokens.colors.border}`, borderRadius:tokens.radius.field,\n                    background:tokens.colors.surface, color:tokens.colors.textPrimary, outline:'none',\n                  }} />\n                </div>\n                <div style={{ display:'flex', alignItems:'center', gap:4, fontSize:tokens.fontSize.xs, color:tokens.colors.textSecondary }}>\n                  <Calendar size={14} />\n                  <span>Từ 01/07</span>\n                  <span>→</span>\n                  <span>Đến 31/07</span>\n                </div>\n                <span style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textSecondary, display:'flex', alignItems:'center', gap:4 }}>\n                  <Filter size={14} /> Danh mục\n                </span>\n              </div>\n              <div style={{ display:'flex', gap:6 }}>\n                <Button variant=\"run\" icon={Plus}>Thêm chi phí</Button>\n                <Button variant=\"danger\" icon={Trash2}>Xóa</Button>\n              </div>\n            </div>\n\n            {/* Grid */}\n            <Panel style=\"translucent\" title={`Chi phí · ${expenses.length} khoản`} icon={ArrowDownCircle}\n              titleTrailing={<span style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>Tổng: <strong style={{ color:tokens.colors.dangerFg }}>4.600.000 ₫</strong></span>}>\n              {/* Header */}\n              <div style={{\n                display:'grid', gridTemplateColumns:'32px 1fr 1fr 1.5fr 1fr 100px',\n                gap:8, padding:'4px 8px', background:tokens.colors.gridHeaderBg, borderRadius:tokens.radius.field,\n                fontSize:tokens.fontSize.xs, fontWeight:600, color:tokens.colors.gridHeaderFg\n              }}>\n                <span></span>\n                <span>Ngày</span>\n                <span>Danh mục</span>\n                <span>Mô tả</span>\n                <span>Trạng thái</span>\n                <span style={{ textAlign:'right' }}>Số tiền</span>\n              </div>\n\n              {/* Rows */}\n              {expenses.map((e, i) => (\n                <div key={i} style={{\n                  display:'grid', gridTemplateColumns:'32px 1fr 1fr 1.5fr 1fr 100px',\n                  gap:8, padding:'6px 8px', alignItems:'center',\n                  background:i%2===0?tokens.colors.surface:'#FAFBFC',\n                  borderBottom:`1px solid ${tokens.colors.borderSubtle}`,\n                  fontSize:tokens.fontSize.sm,\n                }}>\n                  <input type=\"checkbox\" style={{ margin:0 }} />\n                  <span style={{ color:tokens.colors.textPrimary }}>{e.date}</span>\n                  <span style={{ display:'flex', alignItems:'center', gap:4 }}>\n                    <div style={{ width:8, height:8, borderRadius:2, background:tokens.category[e.catKey as keyof typeof tokens.category] }} />\n                    <span style={{ color:tokens.colors.textSecondary }}>{e.cat}</span>\n                  </span>\n                  <span style={{ color:tokens.colors.textPrimary, overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap' }}>\n                    {e.desc}\n                    {e.inv && <span style={{ marginLeft:4, fontSize:tokens.fontSize.xs, opacity:0.6 }}>🖼️</span>}\n                  </span>\n                  <span>\n                    <Badge variant={e.status==='paid'?'success':e.status==='pending'?'warning':'error'} dot>\n                      {e.status==='paid'?'Đã TT':e.status==='pending'?'Chờ TT':'Đã hủy'}\n                    </Badge>\n                  </span>\n                  <span style={{ textAlign:'right', fontWeight:500, color:tokens.colors.textPrimary }}>{formatVND(e.amount)}</span>\n                </div>\n              ))}\n\n              {/* Pagination */}\n              <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginTop:tokens.spacing.sm, fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>\n                <span>✅ Đã chọn 0 dòng</span>\n                <span>[1] / 1 trang</span>\n              </div>\n            </Panel>\n          </div>\n        )}\n\n        {/* ========== TAB 3: TOKENS ========== */}\n        {tab === tabs[3] && (\n          <div style={{ display:'flex', flexDirection:'column', gap:tokens.spacing.md }}>\n            <Panel title=\"Spacing Scale\" icon={LayoutGrid}>\n              <div style={{ display:'flex', flexDirection:'column', gap:4 }}>\n                {Object.entries(tokens.spacing).map(([key, val]) => (\n                  <div key={key} style={{ display:'flex', alignItems:'center', gap:8, fontSize:tokens.fontSize.sm }}>\n                    <span style={{ width:60, color:tokens.colors.textMuted, fontFamily:'monospace' }}>--spacing-{key}</span>\n                    <div style={{ height:16, width:Math.min(val*4,200), background:tokens.colors.accentBg, borderRadius:2 }} />\n                    <span style={{ color:tokens.colors.textSecondary }}>{val}px</span>\n                  </div>\n                ))}\n              </div>\n            </Panel>\n\n            <Panel title=\"Border Radius\" icon={Component}>\n              <div style={{ display:'flex', gap:16, alignItems:'flex-end' }}>\n                {Object.entries(tokens.radius).map(([key, val]) => (\n                  <div key={key} style={{ textAlign:'center' }}>\n                    <div style={{ width:48, height:48, background:tokens.colors.accentBg, border:`2px solid ${tokens.colors.accentFg}`, borderRadius:val, marginBottom:4 }} />\n                    <span style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>{key} ({val}px)</span>\n                  </div>\n                ))}\n              </div>\n            </Panel>\n\n            <Panel title=\"Typography\" icon={FileText}>\n              <div style={{ display:'flex', flexDirection:'column', gap:8 }}>\n                {Object.entries(tokens.fontSize).map(([key, size]) => (\n                  <div key={key} style={{ display:'flex', alignItems:'baseline', gap:12 }}>\n                    <span style={{ width:30, fontFamily:'monospace', fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>{key}</span>\n                    <span style={{ fontSize:size, color:tokens.colors.textPrimary }}>Quản Lý Thu Chi — The quick brown fox</span>\n                    <span style={{ fontSize:tokens.fontSize.xs, color:tokens.colors.textMuted }}>{size}px</span>\n                  </div>\n                ))}\n              </div>\n            </Panel>\n\n            <Panel title=\"Usage in Code\">\n              <div style={{ fontSize:tokens.fontSize.sm, fontFamily:'monospace', color:tokens.colors.textSecondary, background:tokens.colors.gridHeaderBg, padding:8, borderRadius:tokens.radius.field, lineHeight:1.8 }}>\n                <div><span style={{color:'#7C3AED'}}>import</span> {'{'} colors, spacing, radius {'}'} <span style={{color:'#7C3AED'}}>from</span> <span style={{color:'#16A34A'}}>'@/ui/theme'</span>;</div>\n                <div style={{marginTop:4}}>{'// Tailwind CSS class'}</div>\n                <div>&lt;div <span style={{color:'#2563EB'}}>className</span>=<span style={{color:'#16A34A'}}>\"bg-[var(--color-surface)] p-[var(--spacing-md)]\"</span>&gt;</div>\n                <div style={{marginTop:4}}>{'// Inline style (dynamic)'}</div>\n                <div>&lt;div <span style={{color:'#2563EB'}}>style</span>={'{'}{'{'} <span style={{color:'#2563EB'}}>color:</span> colors.accentFg {'}'}{'}'}&gt;</div>\n              </div>\n            </Panel>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n}",
