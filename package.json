    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.0.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "sql.js": "^1.0.0",
