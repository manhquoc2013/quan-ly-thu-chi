    "@mlc-ai/web-llm": "^0.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "idb": "^8.0.0",
    "immer": "^11.1.15",
    "lucide-react": "^0.400.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
