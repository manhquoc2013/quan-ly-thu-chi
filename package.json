{
  "name": "quan-ly-thu-chi",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "homepage": "https://manhquoc2013.github.io/quan-ly-thu-chi",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "rm -rf node_modules/.vite && vite --force",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "npm run typecheck && npm run test",
    "deploy": "vite build --base=/quan-ly-thu-chi/",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
